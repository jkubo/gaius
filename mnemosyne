#!/usr/bin/env python3
"""mnemosyne - Memory file health and maintenance tool.

Usage:
  mnemosyne [--memory-dir DIR] <command> [args]

Options:
  --memory-dir DIR  Path to memory root
                    (env: MNEMOSYNE_MEMORY_DIR, default: ~/.gaius/memory)

Commands:
  health           Line counts, byte sizes and threshold status for all memory files.
                   Line and byte thresholds are BOTH applied (worse verdict wins) —
                   the line cap alone is satisfiable by reflow.
                   Also lints MEMORY.md for index-line gloss accretion (Gap-32),
                   pointers that no longer resolve (Gap-42), changelog bullets that
                   duplicate an event already recorded (Gap-43), and, when over byte
                   budget, points at the heaviest lines to compress.
  audit            Scan common.md for entries that belong in domain files
  split <file>     Propose a split plan for an oversized file (never auto-executes)
  prune <file>     Identify redundant or stale entries (never auto-deletes)
"""

import argparse
import os
import re
import sys
from pathlib import Path

# ── Configuration ────────────────────────────────────────────────────────────

def _default_memory_dir() -> Path:
    # Priority: env var > gaius config > ~/.gaius/memory
    if os.environ.get("MNEMOSYNE_MEMORY_DIR"):
        return Path(os.environ["MNEMOSYNE_MEMORY_DIR"])
    cfg = Path.home() / ".gaius" / "config.yaml"
    if cfg.exists():
        try:
            import yaml
            data = yaml.safe_load(cfg.read_text()) or {}
            p = data.get("mnemosyne", {}).get("memory_dir")
            if p:
                return Path(p).expanduser()
        except Exception:
            pass
    return Path.home() / ".gaius" / "memory"

DEFAULT_MEMORY_DIR = _default_memory_dir()

# Thresholds — (warn, error) line counts per file category.
# GREEN: below warn. YELLOW: warn ≤ lines < error. RED: lines ≥ error.
THRESHOLDS = {
    "MEMORY.md":  (180, 200),
    "common.md":  (80,  100),
    "domain":     (150, 200),   # applies to all domain/*.md
    "skills":     (300, 500),   # skills/*.md — longer than domain (no gotchas), shorter than other
    "other":      (400, 600),   # host-layer topic files (narrative/deep-ref, OK to be long)
}

# Byte thresholds — (warn, error) BYTES per file category, evaluated ALONGSIDE the
# line thresholds above. A file reports the WORSE of the two verdicts; lines stay as
# a readability proxy (a 200-line file is hard to scan whatever it weighs).
#
# Why bytes are needed at all: the injection cost is BYTES, lines are only a proxy,
# and the two decoupled. domain/services.md sat at exactly 149 lines — GREEN, one
# line under the warn — from 2026-07-14 to 2026-07-31 while growing 18,484 → 31,814 B.
# The line gate is satisfiable by REFLOW: join two bullets, the count drops, the cost
# does not. Four domain files are pinned at 149; five exceeded MEMORY.md's own 20KB
# ERROR ceiling while every one of them read GREEN.
#
# Calibration is from the INJECTION BUDGET, not from the current distribution —
# numbers chosen to fit today's files would just re-bless the drift:
#   MEMORY.md loads EVERY session          → 16KB warn / 20KB error (below).
#   domain/*.md load ON DEMAND (1-3 per session, not every session) → may be looser:
#     warn = 20KB — MEMORY.md's hard ERROR ceiling. A demand-loaded file may reach the
#                   size that is already a failure for the always-on index, but it does
#                   not get past that unremarked.
#     err  = 28KB — 1.4× the warn, ≈7k tokens. Ceiling on a 3-domain-file load (~84KB)
#                   and on one-pass readability for the surgeon who has to split it.
# Categories absent from this map are line-gated only (skills/other are narrative
# deep-reference by design; MEMORY.md has its own dedicated byte block in cmd_health).
BYTE_THRESHOLDS = {
    "domain":     (20 * 1024, 28 * 1024),
}

# ── Gap 58: the trees NOTHING gates ──────────────────────────────────────────
# cmd_health _add()s exactly four sets: MEMORY.md/common.md, root *.md, domain/,
# skills/. project/ and troubleshooting/ are never added AT ALL — no line gate, no
# byte gate, never in the table, cannot go YELLOW or RED. Measured 2026-08-07:
# gated domain/ 244KB (18 files) + skills/ 306KB (39) = 550KB; ungated project/
# 1,763KB (123 files) + troubleshooting/ 577KB (43) = 2,340KB — 81% of the corpus
# by bytes was unmeasured. Largest single file: 145KB / 989 lines, 5x the domain
# ERROR ceiling.  Gap 51's byte gate was built for ONE tree and never extended.
#
# Advisory ceiling, derived the same way the domain numbers were — from the
# injection budget, NOT from today's distribution (fitting the current spread
# would just re-bless the drift, per the note above):
#   MEMORY.md   every session          → 16KB warn
#   domain/*.md on demand, 1-3/session → 20KB warn (= MEMORY.md's hard ERR), 28KB err
#   project/, troubleshooting/*.md     → 28KB (= the domain tree's ERR ceiling).
# A file loaded even less often than a domain file may reach the size that is
# already a failure for domain, but it does not get past it unremarked.
#
# 🔴 REPORTED, NOT RANKED — deliberately. These files get NO verdict row and can
# never go RED, because RED is not advisory: .git/hooks/pre-commit in BOTH the
# memory repo and Brain greps for the RED token and exit 1s. The principled
# 28KB/40KB pair (1.4x, exactly domain's ratio) would put 11 files over the error
# ceiling on the day it shipped and BLOCK EVERY COMMIT in both repos, including
# the nightly auto-commit, until 11 large files were hand-split. Visibility is
# separable from enforcement; this ships the half that cannot break the tree.
UNGATED_TREES = ("project", "troubleshooting")
UNGATED_ADVISORY_BYTES = 28 * 1024

# Gap 55/59 — every tree that carries an index must be a BIJECTION with it.
# (tree, index filename, match mode, key prefix). The scanner was built for
# feedback/ in 2026-07-03 and never extended, so `project/` drifted to 29 unlisted
# files before a session counted by hand (closed 2026-08-07); `troubleshooting/`
# was never measured at all.
#
# 🔑 Two match modes, because the two index STYLES differ and precision beats
# uniformity. feedback/INDEX.md lists bare rule keys in prose ("finint_exit,
# analysis_node") ⇒ 'key' mode, word-boundary token match. project/ and
# troubleshooting/ INDEX.md list relative markdown links ⇒ 'link' mode, exact
# filename match. Applying 'link' mode to feedback would report all 171 rules
# missing on the first run; applying 'key' mode to project/ would score a file
# listed because a gloss happened to use its noun. Zero false POSITIVES is the
# bar (same as scan_pointer_content) — both modes fail toward silence.
#
# ⚠️ Glob is `*.md`, NOT `<prefix>_*.md`: 4 feedback rules and 2 project files
# carry no prefix and were invisible to the prefix glob. Measured 0 new findings
# when widened (2026-08-07), so the blind spot cost nothing to close.
INDEX_TREES = (
    ("feedback",        "INDEX.md", "key",  "feedback_"),
    ("project",         "INDEX.md", "link", ""),
    ("troubleshooting", "INDEX.md", "link", ""),
)

# Domain keyword map — used by `audit` to flag common.md entries.
# key = domain file stem, value = keywords that signal domain-specific content.
# Loaded from ~/.gaius/config.yaml [mnemosyne.audit_keywords] if present;
# otherwise uses generic infra/ops defaults below.
def _load_domain_keywords() -> dict:
    # Respect GAIUS_CONFIG env var so tests can override with /dev/null
    cfg_env = os.environ.get("GAIUS_CONFIG")
    cfg = Path(cfg_env) if cfg_env else (Path.home() / ".gaius" / "config.yaml")
    if cfg.exists() and cfg != Path("/dev/null"):
        try:
            import yaml
            data = yaml.safe_load(cfg.read_text()) or {}
            kw = data.get("mnemosyne", {}).get("audit_keywords")
            if kw and isinstance(kw, dict):
                return kw
        except Exception:
            pass
    return {
        "storage":       ["drbd", "pvc", "storageclass", "nfs", "nvme", "sata", "blob",
                          "minio", "s3", "volume", "persistent"],
        "networking":    ["flannel", "cilium", "wireguard", "vxlan", "mtu", "cidr", "ingress",
                          "dns", "cors", "traefik", "http2", "loadbalancer", "tunnel"],
        "services":      ["helm", "oidc", "oauth2", "cert-manager", "ingress-controller"],
        "security":      ["vault", "secret", "tls", "cert", "rbac", "token",
                          "kubeconfig", "credential"],
        "gitops":        ["flux", "helmrelease", "kustomization", "gitops", "reconcile", "ci/cd"],
        "observability": ["alert", "metric", "dashboard", "prometheus", "grafana", "loki", "otel"],
    }

DOMAIN_KEYWORDS = _load_domain_keywords()

# ANSI colors
GREEN  = "\033[32m"
YELLOW = "\033[33m"
RED    = "\033[31m"
BOLD   = "\033[1m"
RESET  = "\033[0m"


# Severity ranks — ordered so max() picks the WORSE of two verdicts.
GREEN_RANK, YELLOW_RANK, RED_RANK = 0, 1, 2
RANK_LABEL = {
    GREEN_RANK:  f"{GREEN}GREEN{RESET}",
    YELLOW_RANK: f"{YELLOW}YELLOW{RESET}",
    RED_RANK:    f"{RED}{BOLD}RED{RESET}",   # exact token the pre-commit hook greps to block
}


def rank_status(value: int, warn: int, error: int) -> int:
    """Severity rank of `value` against a (warn, error) pair. Works for lines or bytes."""
    if value >= error:
        return RED_RANK
    elif value >= warn:
        return YELLOW_RANK
    return GREEN_RANK


def color_status(lines: int, warn: int, error: int) -> str:
    return RANK_LABEL[rank_status(lines, warn, error)]


def count_lines(path: Path) -> int:
    try:
        return sum(1 for _ in path.open())
    except Exception:
        return -1


def count_bytes(path: Path) -> int:
    try:
        return path.stat().st_size
    except Exception:
        return -1


# A "- **bold bullet" merged mid-line (a missing newline between two facts).
# Requires a non-space char immediately before "- **" so legit " - **inline**"
# prose and internal hyphens in dates ("2026-06-08") don't false-positive.
JOINED_BULLET = re.compile(r"\S- \*\*")
LONG_LINE_CHARS = 2000   # a single line this long is accretion (changelog / mega-hook), not a fact


def scan_content_defects(path: Path):
    """Structural defects invisible to line/byte thresholds.

    Returns [(lineno, kind, detail)] where kind is 'joined-line' (corruption —
    a bullet got merged onto the previous line, hiding a fact) or 'long-line'
    (one runaway line; index/header accretion). Joined-line is blocking; long-line
    is advisory.
    """
    defects = []
    try:
        for i, raw in enumerate(path.open(), 1):
            line = raw.rstrip("\n")
            m = JOINED_BULLET.search(line)
            if m:
                start = max(0, m.start() - 22)
                defects.append((i, "joined-line", "…" + line[start:m.start() + 24].strip()))
            elif len(line) > LONG_LINE_CHARS:
                defects.append((i, "long-line", f"{len(line)} chars on one line"))
    except Exception:
        pass
    return defects


# ── MEMORY.md index-gloss accretion (Gap-32 structural cure) ──────────────────
# The byte budget catches the TOTAL but not WHERE, and the 2000-char runaway
# check never fires on index lines (they top out ~1300-1700 chars). So the
# `## Project Files` index mega-lines accrete gloss until the 16KB budget blows,
# and every surgeon then hand-hunts the fat lines. This lint catches the
# accretion EARLY by measuring *non-link gloss bytes* — it strips `[label](path)`
# link tokens and counts the remaining prose, so a vertical with many terse links
# is fine but one whose links carry paragraph glosses is flagged. Detail on an
# index line belongs in the linked project file; the index is navigation.
INDEX_GLOSS_WARN = 350         # non-link gloss bytes on one index line over this = accretion
PROJECT_FILES_HEADER = "## Project Files"
_LINK_TOKEN = re.compile(r"\[[^\]]*\]\([^)]*\)")


def scan_index_gloss(path: Path, threshold: int = INDEX_GLOSS_WARN):
    """Index lines under '## Project Files' carrying > `threshold` bytes of
    non-link gloss. Returns [(lineno, gloss_bytes, total_bytes, preview)]
    heaviest-first. Advisory only — never blocks (the index is navigation; the
    detail belongs in the linked file)."""
    fat = []
    in_section = False
    try:
        for i, raw in enumerate(path.open(), 1):
            line = raw.rstrip("\n")
            if line.startswith(PROJECT_FILES_HEADER):
                in_section = True
                continue
            if in_section and line.startswith("## "):
                break  # next H2 ends the index section
            if in_section and line.lstrip().startswith(("-", "*")):
                gloss = len(_LINK_TOKEN.sub("", line))
                if gloss > threshold:
                    fat.append((i, gloss, len(line), line.lstrip()[:50]))
    except Exception:
        pass
    fat.sort(key=lambda t: -t[1])
    return fat


# A fat bullet under '## Recent State' is a fact that outgrew the changelog: it
# should be homed in a project/domain file with a pointer left behind (or rolled
# to archive/ by `gaius recent-roll`). Separate from scan_index_gloss on purpose —
# that one is scoped to '## Project Files' and must NOT widen to Recent State.
RECENT_STATE_HEADER = "## Recent State"
RECENT_STATE_BULLET_WARN = 600   # non-link gloss bytes on one Recent-State bullet over this = accretion


def scan_recent_state_bullets(path: Path, threshold: int = RECENT_STATE_BULLET_WARN):
    """Bullets under the '## Recent State' H2 carrying > `threshold` bytes of
    non-link gloss (link tokens stripped, mirroring scan_index_gloss). Returns
    [(lineno, gloss_bytes, total_bytes, preview)] heaviest-first. Advisory only —
    never blocks (Recent State is a changelog; the fix is to home the fact)."""
    fat = []
    in_section = False
    try:
        for i, raw in enumerate(path.open(), 1):
            line = raw.rstrip("\n")
            if line.startswith(RECENT_STATE_HEADER):
                in_section = True
                continue
            if in_section and line.startswith("## "):
                break  # next H2 ends the Recent State section
            if in_section and line.lstrip().startswith(("-", "*")):
                gloss = len(_LINK_TOKEN.sub("", line))
                if gloss > threshold:
                    fat.append((i, gloss, len(line), line.lstrip()[:50]))
    except Exception:
        pass
    fat.sort(key=lambda t: -t[1])
    return fat


# ── Recent State event duplication (Gap-43 structural cure) ──────────────────
# The index is APPEND-oriented: every session ends by writing a bullet for what
# it just learned, and nothing checks whether a bullet already covers that event.
# In practice one incident gets written TWICE by two sessions that each summarise
# it independently — same issues, same root cause, different prose. Merging a
# single such pair reclaimed more bytes than every prose trim in that pass
# combined. So duplication, not growth, is the dominant driver of a RED byte
# budget. Nothing detected it.
#
# Detection is by SHARED RARE IDENTIFIERS, not prose similarity: two bullets on
# one event cite the same issue/PR numbers, the same commit SHA, the same
# backticked symbols. Two bullets merely about the same SUBSYSTEM share none of
# those. Tokens appearing in more than DUP_DF_CAP bullets are common vocabulary
# for this file and are dropped from every signature.
#
# Zero false positives is the bar (same as scan_pointer_resolution). Measured
# over 30 committed MEMORY.md versions (15-44 bullets each): ONE pair flagged,
# hand-verified a TRUE duplicate (a multi-issue salvage bullet written twice a
# day apart, never noticed by any session); zero false positives. A replay of
# the reconstructed pair rediscovers it.
#
# Advisory only. The fix for a hit is a MERGE, never a delete — two bullets on
# one event usually each carry a detail the other lacks.
EARLIER_HEADER = "## Earlier"     # rolled changelog — a re-add after roll is the same defect
DUP_DF_CAP        = 3   # token in > this many bullets = common vocabulary, not an event id
DUP_MIN_STRONG    = 2   # shared issue/PR refs or SHAs alone
DUP_MIN_MIXED_WEAK = 2  # ...or 1 strong + this many shared backticked symbols
DUP_MIN_WEAK      = 4   # ...or this many shared symbols with no strong token

# #NNN issue/PR refs. Bounded to 2-4 digits: `#1` is too common, and longer runs
# are timestamps/ports, not issues.
#
# ENDPOINTS ONLY, deliberately. "#285-#288" contributes {#285, #288} and not the
# interior. Expanding the span was BUILT AND REVERTED after replay over 40
# committed MEMORY.md versions: only 3 bullets in that whole history carry a
# bounded range, expansion found ZERO additional true duplicates, and it produced
# ONE false positive (two same-day bullets from unrelated workstreams, citing
# "#144-148" and "#147-154" — flagged as one event purely because two
# hand-written ranges happen to overlap). Ranges in this file are
# approximations, so their interiors are not evidence of a shared event. Do not
# re-add without a population count first; the zero-false-positive bar is what
# makes this scanner worth reading.
_DUP_ISSUE = re.compile(r"#(\d{2,4})\b")
# Hex SHAs. Lookaheads force at least one digit AND one a-f letter, so English
# words ("added", "deface") and pure numbers never qualify as a commit id.
_DUP_SHA = re.compile(r"\b(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])([0-9a-f]{7,40})\b")
# A backticked token counts only if it is identifier-SHAPED: punctuation that
# occurs in symbols/paths/flags, or a word long enough not to be prose emphasis.
_DUP_IDENTISH = re.compile(r"[_\-./=]|[a-z]{5,}")


def _dup_signature(line: str):
    """(strong, weak) identifier sets for one bullet. strong = issue refs + SHAs
    (an event fingerprint); weak = backticked identifier-shaped symbols."""
    strong = {"#" + m.group(1) for m in _DUP_ISSUE.finditer(line)}
    strong |= {"sha:" + m.group(1)[:8] for m in _DUP_SHA.finditer(line)}
    weak = set()
    for m in RE_TICK.finditer(line):
        t = m.group(1).strip().lower()
        if 5 <= len(t) <= 60 and _DUP_IDENTISH.search(t):
            weak.add(t)
    return strong, weak


def scan_recent_state_duplicates(path: Path, df_cap: int = DUP_DF_CAP):
    """Pairs of changelog bullets that cite the same rare identifiers — i.e. two
    sessions wrote the same event twice. Scans '## Recent State' AND '## Earlier'
    (a bullet re-added after being rolled is the same defect). Returns
    [(lineno_a, lineno_b, kind, shared_strong, shared_weak, preview_a, preview_b)]
    strongest-first. Advisory only — the fix is a MERGE, not a delete."""
    entries = []
    in_section = False
    try:
        for i, raw in enumerate(path.open(), 1):
            line = raw.rstrip("\n")
            if line.startswith((RECENT_STATE_HEADER, EARLIER_HEADER)):
                in_section = True
                continue
            if in_section and line.startswith("## "):
                in_section = False      # keep scanning: Earlier may follow later
                continue
            if in_section and line.lstrip().startswith(("-", "*")):
                body = line.lstrip()
                s, w = _dup_signature(body)
                entries.append((i, s, w, body[:50]))
    except Exception:
        return []

    df = {}
    for _, s, w, _ in entries:
        for t in s | w:
            df[t] = df.get(t, 0) + 1
    rare = {t for t, c in df.items() if c <= df_cap}

    hits = []
    for a in range(len(entries)):
        for b in range(a + 1, len(entries)):
            la, sa, wa, pa = entries[a]
            lb, sb, wb, pb = entries[b]
            ss, sw = (sa & sb) & rare, (wa & wb) & rare
            if len(ss) >= DUP_MIN_STRONG:
                kind = "same-ids"
            elif ss and len(sw) >= DUP_MIN_MIXED_WEAK:
                kind = "same-id+symbols"
            elif len(sw) >= DUP_MIN_WEAK:
                kind = "same-symbols"
            else:
                continue
            hits.append((la, lb, kind, sorted(ss), sorted(sw), pa, pb))
    hits.sort(key=lambda h: (-len(h[3]), -len(h[4])))
    return hits


# ── MEMORY.md pointer resolution (Gap-42 structural cure) ────────────────────
# A pointer is a CLAIM about another file, and it rots independently of the
# bullet it sits on — in one surgeon pass ~30% of MEMORY.md pointers
# were wrong while their bullets were still true. Three rot classes were seen:
#   (b) dangling      — the target path does not exist
#   (c) ambiguous     — `networking.md` is BOTH domain/ and troubleshooting/,
#                       different content; picking one silently reads the wrong file
#   (a) points at content the target never asserts
# (b) and (c) are mechanical. The mechanical SUBSET of (a) is a `§anchor` naming
# a heading/label the target does not have. Semantic (a) — target exists but
# contradicts the claim — needs a reader and stays with the /mnemos surgeon.
#
# Zero false positives is the bar (same as scan_index_completeness). MEMORY.md is
# dense with backticked code identifiers, k8s verbs, HTTP routes, shell commands
# and paths into OTHER repos — none are pointers. Everything is rejected unless
# it looks like a memory-root .md path; see _resolve_pointer's reject ladder.

# Directories a MEMORY.md pointer can legitimately name. Derived from the tree,
# not from docs (no doc enumerates them). A slashed target whose first segment is
# absent here is a file in another repo (postmortem/…, manifests/…) — silent.
POINTER_ROOTS = ("", "domain", "troubleshooting", "project", "specs",
                 "reference", "skills", "feedback", "user", "sop", "handoffs")

# finditer, never search: 25 MEMORY.md lines carry >=2 targets (one carries 5).
RE_MD_LINK    = re.compile(r"\[[^\]\n]+\]\((?P<target>[^)\s]+)\)")
RE_ARROW_BARE = re.compile(r"→\s*\**\s*(?P<target>[A-Za-z0-9_~./-]+\.md)\b")
RE_TICK       = re.compile(r"`(?P<target>[^`\n]+)`")
RE_ANCHOR     = re.compile(r"§(?P<anchor>[\w./-]+(?:\s+[a-z]+\s+\d+)?)")

_SCHEME = re.compile(r"^(?:https?|mailto|ftp|git\+ssh)://|^//")
# Characters that cannot occur in a memory path but are everywhere in the code
# tokens MEMORY.md quotes: verbs like pods/exec:create, glob-shaped config keys,
# wildcarded module paths, and bare prefixes such as WIP:
_BAD_PATH_CHARS = set(":@$(){}<>|&!*?")
# A trailing "step 5" / "line 3" qualifier is not part of the section name.
_ANCHOR_STOPWORDS = {"step", "steps", "line", "lines", "section", "part", "item", "no"}


def _normalize_target(raw: str, root: Path):
    """Root-relative POSIX string, or None if the target is out of scope.

    Absolute and ~-rooted targets are resolved and kept only if they land inside
    the memory root — the same tree is addressable three ways here
    (a config dir, a checkout, and a symlinked alias can all name it), so the
    root is canonicalized once and everything is compared against it.
    """
    t = raw.strip()
    if t.startswith("~") or t.startswith("/"):
        try:
            p = Path(t).expanduser().resolve()
            return p.relative_to(root).as_posix()
        except (OSError, RuntimeError, ValueError):
            return None          # unreadable, or a real file in another tree
    return t


def _resolve_pointer(raw: str, root: Path):
    """('ok', Path|None) | ('dangling', None) | ('ambiguous', [Path,...]) | ('skip', None).

    'skip' means "not a pointer" — the reject ladder below is what makes this
    check quiet, not the resolver.
    """
    if not raw or _SCHEME.match(raw):
        return ("skip", None)                       # URLs
    if any(c.isspace() for c in raw):
        return ("skip", None)                       # shell commands, prose
    if any(c in _BAD_PATH_CHARS for c in raw):
        return ("skip", None)                       # k8s verbs, globs, env vars

    # Read the trailing-slash intent BEFORE normalizing: Path.resolve() strips it,
    # which would silently demote a `<memory-root>/sop/` dir to a non-.md skip.
    is_dir_ptr = raw.rstrip().endswith("/")
    rel = _normalize_target(raw, root)
    if rel is None:
        return ("skip", None)
    rel = rel.rstrip("/")
    if not rel or rel == ".":
        return ("skip", None)

    if is_dir_ptr:                                  # `domain/`, `sop/` — but not `oms/`
        if rel not in POINTER_ROOTS:
            return ("skip", None)
        return ("ok", root / rel) if (root / rel).is_dir() else ("dangling", None)

    if not rel.endswith(".md"):
        return ("skip", None)                       # ci.yml, k0.py, ./deploy.sh, `networking`

    if "/" in rel:
        if rel.split("/", 1)[0] not in POINTER_ROOTS:
            return ("skip", None)                   # another repo's .md
        p = root / rel
        return ("ok", p) if p.exists() else ("dangling", None)

    hits, seen = [], set()                          # bare basename — may collide
    for r in POINTER_ROOTS:
        p = (root / r / rel) if r else (root / rel)
        try:
            if not p.exists():
                continue
            key = p.resolve()
        except OSError:
            continue
        if key not in seen:
            seen.add(key)
            hits.append(p)
    if not hits:
        return ("dangling", None)
    if len(hits) > 1:
        return ("ambiguous", hits)                   # never pick one — ambiguity must be loud
    if hits[0].parent == root:
        return ("ok", hits[0])                       # bare name that IS at the root
    # Resolves, but only because we searched. Gap 42 calls this class (c)
    # "unresolvable path": the six bare `project_*.md` refs "do not exist at the
    # memory root", and the surgeon's repair was to path-qualify them. A reader
    # following the pointer has to guess the directory, so a unique hit is not a
    # pass — it is an unqualified pointer with a known repair.
    return ("unqualified", hits)


def _names_an_unread_md(raw: str) -> bool:
    """True for a target the resolver SKIPPED that is nonetheless plainly a
    destination: a whitespace-free `.md` path in another tree (`archive/x.md`,
    `oms/README.md`) or an absolute path outside the memory root.

    'skip' is overloaded — it is also every backticked shell token and k8s verb
    on the line — so only scan_pointer_content's abstain rule uses this, and it
    reads the raw text rather than the resolver's verdict.
    """
    t = raw.strip()
    return (len(t) > 3 and t.endswith(".md")
            and not any(c.isspace() for c in t)
            and not _SCHEME.match(t))


def _anchor_tokens(anchor: str):
    out = []
    for t in re.split(r"[\s/_-]+", anchor.strip().lower()):
        if not t:
            continue
        if t.isdigit() or t in _ANCHOR_STOPWORDS:
            break
        t = re.sub(r"[^\w]", "", t)
        if t:
            out.append(t)
    return out


def _anchor_present(anchor: str, path: Path) -> bool:
    """Does `anchor` name a heading or a bold label run in `path`?

    Bold labels are mandatory, not a nicety: domain/services.md has no `Registry`
    heading — the section lives under `**Registry**:`. A heading-only matcher
    false-positives there. Prefix matching + the stopword/digit break keep
    `§RBAC step 5` (-> `## RBAC Review Pattern`) a pass.
    """
    want = _anchor_tokens(anchor)
    if not want:
        return True                                 # e.g. "§5" — nothing checkable
    try:
        text = path.read_text(errors="ignore")
    except (OSError, UnicodeDecodeError):
        return True                                 # fail quiet
    for line in text.splitlines():
        s = line.strip()
        if not (s.startswith("#") or s.startswith("**")):
            continue
        hay = re.sub(r"[^\w\s]", " ", s.lower()).split()
        if all(any(h.startswith(w) for h in hay) for w in want):
            return True
    return False


def _extract_pointers(line: str):
    """[(start, end, target)] — extractors applied in precedence order, with
    overlapping spans dropped so a link target is not re-read as a bare path."""
    found = []
    for rx in (RE_MD_LINK, RE_ARROW_BARE, RE_TICK):
        for m in rx.finditer(line):
            s, e = m.span("target")
            if any(s < pe and ps < e for ps, pe, _ in found):
                continue
            found.append((s, e, m.group("target")))
    found.sort()
    return found


def scan_pointer_resolution(memory_dir: Path):
    """Every `[x](path)` / `→ path` / backticked `.md` pointer in MEMORY.md must
    resolve to exactly one real file under the memory root, and a named §anchor
    must name a real heading or bold label in that file.

    Returns [(relfile, lineno, kind, target, detail)] sorted by line, where kind
    is 'dangling' | 'ambiguous' | 'anchor'. WARN-mode (advisory) — never blocks:
    mnemosyne's only blocking channel is the RED token the pre-commit hook greps,
    and stranding the nightly memory auto-commit over a broken link is a worse
    failure than the broken link. Scope is MEMORY.md (the always-injected file);
    MNEMOSYNE_POINTER_FILES overrides for experimentation.
    Kill switch: ~/.gaius/pointer-check-disabled.
    """
    try:
        if (Path.home() / ".gaius" / "pointer-check-disabled").exists():
            return []
        root = Path(memory_dir).resolve()
    except (OSError, RuntimeError):
        return []

    names = os.environ.get("MNEMOSYNE_POINTER_FILES", "MEMORY.md")
    findings, seen = [], set()
    for name in [n.strip() for n in names.split(",") if n.strip()]:
        path = root / name
        try:
            if not path.exists():
                continue
            lines = path.read_text(errors="ignore").splitlines()
        except (OSError, UnicodeDecodeError):
            continue

        for i, line in enumerate(lines, 1):
            pointers = _extract_pointers(line)
            if not pointers:
                continue
            resolved = []
            for s, e, raw in pointers:
                kind, payload = _resolve_pointer(raw, root)
                resolved.append((e, raw, kind, payload))
                if kind == "dangling":
                    findings.append((name, i, "dangling", raw,
                                     "no such file under the memory root"))
                elif kind == "ambiguous":
                    rels = ", ".join(p.relative_to(root).as_posix() for p in payload)
                    findings.append((name, i, "ambiguous", raw,
                                     f"resolves to {len(payload)} files: {rels}"))
                elif kind == "unqualified":
                    rel = payload[0].relative_to(root).as_posix()
                    findings.append((name, i, "unqualified", raw,
                                     f"not at the memory root — path-qualify it as {rel}"))

            for m in RE_ANCHOR.finditer(line):       # anchor binds to nearest preceding pointer
                prior = [r for r in resolved if r[0] < m.start()]
                if not prior:
                    continue
                _, raw, kind, payload = max(prior, key=lambda r: r[0])
                if kind == "unqualified":
                    payload = payload[0]   # unique hit — the anchor is still checkable
                elif kind != "ok":
                    continue
                if payload is None or not payload.is_file():
                    continue
                anchor = m.group("anchor")
                if not _anchor_present(anchor, payload):
                    findings.append((name, i, "anchor", raw,
                                     f"§{anchor} names no heading or bold label in "
                                     f"{payload.relative_to(root).as_posix()}"))

    out = []
    for f in findings:                               # dedupe within a line, never across
        key = (f[0], f[1], f[2], f[3])
        if key in seen:
            continue
        seen.add(key)
        out.append(f)
    out.sort(key=lambda t: (t[0], t[1]))
    return out


# Backticked token that is specific enough that its ABSENCE from the pointer target
# is evidence. Needs a structural char (path/dot/dash/underscore/colon/bracket) so
# prose words in backticks don't qualify.
RE_IDENT = re.compile(r"`([^`\n]{3,80})`")
RE_IDENT_STRUCT = re.compile(r"[/._:\-\[\]]")
RE_LINENO_SUFFIX = re.compile(r":\d+(-\d+)?$")


def _distinctive_idents(line: str):
    """Backticked identifiers from a MEMORY.md bullet, minus the pointer paths
    themselves and anything too generic to be evidence."""
    out, seen = [], set()
    for raw in RE_IDENT.findall(line):
        t = raw.strip().strip(".,;:—")
        t = RE_LINENO_SUFFIX.sub("", t)        # `drift-scan.sh:23` → `drift-scan.sh`
        if len(t) < 6 or " " in t:
            continue
        if t.endswith(".md"):                  # that's the pointer, not the fact
            continue
        if not RE_IDENT_STRUCT.search(t):
            continue
        if t not in seen:
            seen.add(t)
            out.append(t)
    return out


def scan_pointer_content(memory_dir: Path):
    """Gap-42 class (a): a MEMORY.md bullet whose `→ file` pointer RESOLVES but whose
    target does not actually contain the fact. scan_pointer_resolution goes GREEN on
    exactly these — it only proves the file exists, never that the content landed —
    so the mechanical check and the real failure mode were disjoint until this.

    Partial by design, and deliberately so: flags a line only when it carries >=2
    distinctive backticked identifiers and NOT ONE of them appears in ANY of the
    line's resolvable targets. That is total absence, which needs no semantic
    understanding; a fact homed under different wording is NOT flagged (accepted
    false-negative — the bar here is zero false POSITIVES, same as its sibling).

    Absence is only evidence when every destination on the line was READ (mnemos
    #168). Idents are gathered line-wide but targets are not: a multi-topic bullet
    can name a directory (`troubleshooting/`), an out-of-root tree (`archive/x.md`
    — archive/ is not in POINTER_ROOTS) or a dangling path, none of which this
    scanner opens, and then the ONE target it did read is held answerable for the
    whole line's idents. That fired on the real MEMORY.md roll-off line, and its
    implied remedy was the wrong one: a reader deletes the second pointer (which
    re-strands the fact) instead of splitting the bullet. So any unread destination
    on the line abstains — trading coverage for the zero-FP bar, as everywhere else
    in this family.

    Returns [(relfile, lineno, idents, targets, preview)]. WARN-mode (advisory).
    Kill switch: ~/.gaius/pointer-check-disabled (shared with scan_pointer_resolution).
    """
    try:
        if (Path.home() / ".gaius" / "pointer-check-disabled").exists():
            return []
        root = Path(memory_dir).resolve()
    except (OSError, RuntimeError):
        return []

    names = os.environ.get("MNEMOSYNE_POINTER_FILES", "MEMORY.md")
    findings = []
    for name in [n.strip() for n in names.split(",") if n.strip()]:
        path = root / name
        try:
            if not path.exists():
                continue
            lines = path.read_text(errors="ignore").splitlines()
        except (OSError, UnicodeDecodeError):
            continue

        for i, line in enumerate(lines, 1):
            idents = _distinctive_idents(line)
            if len(idents) < 2:                       # too fragile to judge on one
                continue
            targets, unread = [], False
            for _s, _e, raw in _extract_pointers(line):
                kind, payload = _resolve_pointer(raw, root)
                if kind == "ok" and payload is not None:
                    if payload.is_file():
                        targets.append(payload)
                    else:
                        unread = True                 # `troubleshooting/` — a dir, no file read
                elif kind == "unqualified" and payload:
                    targets.append(payload[0])        # unique hit — readable
                elif kind in ("dangling", "ambiguous"):
                    unread = True                     # sibling scan owns the repair
                elif kind == "skip" and _names_an_unread_md(raw):
                    unread = True                     # real destination, out of scope
            if unread or not targets:                 # dangling is the sibling's job
                continue

            blob = ""
            for t in targets:
                try:
                    blob += t.read_text(errors="ignore")
                except (OSError, UnicodeDecodeError):
                    continue
            if not blob:
                continue
            # Whitespace-insensitive: MEMORY.md compresses `pods:create` where the
            # target writes YAML-style `pods: create`. Same fact, and treating them
            # as different produced this check's only false positive in testing.
            # Erring permissive is correct here — the bar is zero false POSITIVES.
            squash = re.sub(r"\s+", "", blob)
            if any(ident in blob or re.sub(r"\s+", "", ident) in squash
                   for ident in idents):
                continue                              # at least one landed — good enough

            rels = ", ".join(t.relative_to(root).as_posix() for t in targets)
            findings.append((name, i, idents, rels, line.lstrip()[:50]))

    findings.sort(key=lambda t: (t[0], t[1]))
    return findings


def heaviest_lines(path: Path, n: int = 5):
    """The n heaviest lines in a file (targeting aid when over byte budget):
    [(lineno, nbytes, preview)] heaviest-first.

    Weight is UTF-8 BYTES, not characters. This was `len(line)` until 2026-08-09 while the
    caller printed the figure with a `B` suffix — an undercount on exactly the lines the
    queue exists to surface, because Recent-State bullets are emoji-dense (📌 🔴 🔑 ⚠️ cost
    3-6 bytes each and 1 char). Measured drift on the live index: 470 reported vs 493 actual.
    The budget it serves (`BYTE_THRESHOLDS`, `wc -c`) was always bytes, so this is the axis
    the figure was always claiming to be on."""
    rows = []
    try:
        for i, raw in enumerate(path.open(), 1):
            line = raw.rstrip("\n")
            rows.append((i, len(line.encode("utf-8")), line.lstrip()[:50]))
    except Exception:
        return []
    rows.sort(key=lambda t: -t[1])
    return rows[:n]


# ── Commands ─────────────────────────────────────────────────────────────────

# Left boundary for "is this name listed in the index". Deliberately NOT `\b` — see
# the 🔴 note in scan_index_completeness. Only a genuine identifier character before
# the name means "this is a different, longer name"; `_`, `.` and `-` are markdown
# emphasis and filename punctuation, and rejecting them reported listed files missing.
_LISTED_LEFT = r"(?<![A-Za-z0-9])"

_FENCE_RE = re.compile(r"```.*?```|~~~.*?~~~|<!--.*?-->|`[^`\n]*`", re.S)


def _strip_noncontent(text: str) -> str:
    """Code fences, inline code spans and HTML comments blanked (length-preserving is
    not needed — nothing here reports offsets). Link-shaped text inside them is an
    EXAMPLE, not a link, and treating it as one is a false positive."""
    return _FENCE_RE.sub(" ", text)


def scan_index_completeness(memory_dir: Path, trees=INDEX_TREES):
    """Every indexed tree must be a BIJECTION with its index: no active file
    unlisted, nothing listed that no longer exists.

    Catches the catalog-drift class that let 64 feedback rules — incl HARD gates —
    go invisible in the always-injected awareness layer (cured 2026-07-03), and the
    same class in `project/` (29 unlisted before a hand count found it, cured
    2026-08-07). An index that is not a bijection lies by omission: a session that
    reads only the index cannot know the file exists, and the file's own outbound
    links cannot fix that — an auto-linker writes outbound edges only, so a file can
    look well-connected when opened and still be unreachable.

    Match mode per tree (see INDEX_TREES): 'key' = the stem minus its prefix, for
    prose indexes that list bare keys; 'link' = the exact filename, for indexes that
    list relative markdown links. Ghosts likewise: 'key' trees are checked against
    `.archive/`, 'link' trees against their own dangling link targets.

    🔴 Both modes use `_LISTED_LEFT` and NOT `\\b` for the left boundary, because `\\b`
    treats `_` as a word character and that inverts the failure direction. In key mode
    the stripped prefix is itself the character before the key, so a rule listed by its
    full filename — `[no git stash](feedback_no_git_stash.md)`, the strictly MORE
    informative listing, and the house style of the other two trees — failed `\\b` and
    was reported MISSING. Restyling feedback/INDEX.md to the link form reported 165 of
    171 rules missing against an index that named every one of them. Same defect in
    link mode via markdown emphasis (`_project_foo.md_`). Zero false POSITIVES is the
    bar, so the boundary may only reject a genuine identifier character: `bar_foo.md`
    now counts as listing `foo.md` (a false NEGATIVE, which this design accepts —
    fail toward silence) while `xfoo.md` still does not.

    Returns [(tree, key, kind)], kind 'missing' | 'ghost'. WARN-mode (advisory).
    """
    findings = []
    for tree, index_name, mode, prefix in trees:
        d = memory_dir / tree
        idxp = d / index_name
        if not d.is_dir() or not idxp.exists():
            continue
        try:
            idx = idxp.read_text(errors="ignore")
        except OSError:
            # 🔴 FAIL TOWARD SILENCE, NEVER TOWARD SILENT-CLEAN. errors="ignore" covers
            # decode errors only; a PermissionError here used to propagate out of
            # cmd_health BEFORE any banner printed, so one unreadable index blanked the
            # whole health run — and all three consumers read that as healthy: the
            # pre-commit hook greps output for RED and finds none, mnemos-audit runs
            # `|| true` and greps an allowlist that matches nothing. Skipping one tree
            # loses one scanner; raising loses every gate in the process.
            continue
        active = sorted(p for p in d.glob("*.md") if p.name != index_name)
        if mode == "link":
            present = {p.name for p in active}
            for p in active:
                # Trailing `)` / `#anchor` is left free so an anchored link counts.
                if not re.search(_LISTED_LEFT + re.escape(p.name), idx):
                    findings.append((tree, p.name, "missing"))
            # A bare in-tree link target that does not exist. Cross-tree and
            # parent-relative links carry a `/` and are deliberately not our business.
            # Anchors are allowed here so the two halves agree on what a link IS — the
            # missing-check counts `](gone.md#why)` as a listing, so the ghost-check
            # must be able to call the same entry dangling once its target goes.
            # Code fences and HTML comments are stripped first: link-shaped text quoted
            # as an EXAMPLE names no real file, and reporting it is a false positive.
            for target in sorted(set(re.findall(r"\]\(([A-Za-z0-9._-]+\.md)[)#]",
                                                _strip_noncontent(idx)))):
                if target != index_name and target not in present:
                    findings.append((tree, target, "ghost"))
        else:
            active_keys = set()
            for p in active:
                key = p.stem[len(prefix):] if prefix and p.stem.startswith(prefix) else p.stem
                active_keys.add(key)
                if not re.search(_LISTED_LEFT + re.escape(key) + r"\b", idx):
                    findings.append((tree, key, "missing"))
            arch = d / ".archive"
            if arch.is_dir():
                for p in sorted(arch.glob("*.md")):
                    if p.name == index_name:
                        continue
                    key = p.stem[len(prefix):] if prefix and p.stem.startswith(prefix) else p.stem
                    if key not in active_keys and re.search(
                            _LISTED_LEFT + re.escape(key) + r"\b", idx):
                        findings.append((tree, key, "ghost"))
    return findings


def scan_ungated_trees(memory_dir: Path, ceiling: int = UNGATED_ADVISORY_BYTES):
    """Gap 58: byte weight of the trees cmd_health never measures.

    Returns (over, totals) where `over` is [(rel, size)] above the advisory ceiling,
    heaviest first, and `totals` is [(tree, file_count, total_bytes)] for every
    ungated tree that exists.  Advisory ONLY — the caller must not turn these into
    verdict rows; see UNGATED_TREES for why RED is off the table here."""
    over, totals = [], []
    for tree in UNGATED_TREES:
        d = memory_dir / tree
        if not d.is_dir():
            continue
        n = total = 0
        for p in sorted(d.glob("*.md")):
            sz = count_bytes(p)
            if sz < 0:
                continue
            n += 1
            total += sz
            if sz >= ceiling:
                over.append((f"{tree}/{p.name}", sz))
        totals.append((tree, n, total))
    over.sort(key=lambda t: -t[1])
    return over, totals


def cmd_health(memory_dir: Path, args: list):
    """Print line counts, byte sizes and health status for all memory files."""
    files = []   # (name, lines, line_warn, line_err, size, byte_warn|None, byte_err|None)

    def _add(name: str, path: Path, category: str):
        lwarn, lerr = THRESHOLDS[category]
        bwarn, berr = BYTE_THRESHOLDS.get(category, (None, None))
        files.append((name, count_lines(path), lwarn, lerr, count_bytes(path), bwarn, berr))

    # Named files in root
    for name in ["MEMORY.md", "common.md"]:
        p = memory_dir / name
        if p.exists():
            _add(str(p.relative_to(memory_dir)), p, name)

    # Other root-level .md files (not MEMORY.md/common.md/RULES.md)
    skip_root = {"MEMORY.md", "common.md", "RULES.md"}
    for p in sorted(memory_dir.glob("*.md")):
        if p.name not in skip_root:
            _add(p.name, p, "other")

    # Domain files
    domain_dir = memory_dir / "domain"
    if domain_dir.is_dir():
        for p in sorted(domain_dir.glob("*.md")):
            _add(f"domain/{p.name}", p, "domain")

    # Skills files
    skills_dir = memory_dir / "skills"
    if skills_dir.is_dir():
        for p in sorted(skills_dir.glob("*.md")):
            _add(f"skills/{p.name}", p, "skills")

    # ── Verdict per file: the WORSE of the line and byte checks ──
    # Lines are a readability proxy, bytes are the injection cost; a file that is
    # fine on one and blown on the other is not fine. `why` names which check drove
    # the verdict so the summary banner says lines / bytes / both.
    verdicts = []   # (name, rank, why)
    for fname, lines, lwarn, lerr, size, bwarn, berr in files:
        lrank = rank_status(lines, lwarn, lerr)
        brank = rank_status(size, bwarn, berr) if bwarn is not None else GREEN_RANK
        rank = max(lrank, brank)
        why = "+".join(w for w, r in (("lines", lrank), ("bytes", brank)) if r == rank)
        verdicts.append((fname, rank, why if rank else ""))

    # Print table
    col_file  = max(len(r[0]) for r in files) + 2
    col_lines = 7
    print(f"\n{'File':<{col_file}} {'Lines':>{col_lines}} {'Size':>8}  {'Threshold':<28} Status")
    print("─" * (col_file + col_lines + 41))
    for (fname, lines, lwarn, lerr, size, bwarn, berr), (_, rank, _why) in zip(files, verdicts):
        thresh = f"warn={lwarn}/err={lerr}L"
        if bwarn is not None:
            thresh += f" +{bwarn / 1024:.0f}/{berr / 1024:.0f}KB"
        print(f"{fname:<{col_file}} {lines:>{col_lines}} {size / 1024:>7.1f}K  "
              f"{thresh:<28} {RANK_LABEL[rank]}")

    print()

    # ── MEMORY.md byte budget (injection budget; a few long lines can blow it
    #    while staying under the line cap, so it is checked separately) ──
    BYTE_WARN, BYTE_ERR = 16 * 1024, 20 * 1024
    byte_red = byte_yellow = False
    _mem = memory_dir / "MEMORY.md"
    if _mem.exists():
        _sz = _mem.stat().st_size
        if _sz >= BYTE_ERR:
            _bs = f"{RED}{BOLD}RED{RESET}"; byte_red = True
        elif _sz >= BYTE_WARN:
            _bs = f"{YELLOW}YELLOW{RESET}"; byte_yellow = True
        else:
            _bs = f"{GREEN}GREEN{RESET}"
        print(f"{'File':<{col_file}} {'Size':>7}  Threshold              Status")
        print("─" * (col_file + 30))
        print(f"{'MEMORY.md':<{col_file}} {_sz / 1024:>6.1f}KB  warn=16.0KB/err=20.0KB {_bs}")
        print()

    # ── Content defects: structural corruption invisible to line/byte checks ──
    paths = []
    for name in ["MEMORY.md", "common.md"]:
        p = memory_dir / name
        if p.exists():
            paths.append(p)
    for p in sorted(memory_dir.glob("*.md")):
        if p.name not in skip_root:
            paths.append(p)
    for sub in ("domain", "skills"):
        d = memory_dir / sub
        if d.is_dir():
            paths.extend(sorted(d.glob("*.md")))
    joined, longish = [], []
    for p in paths:
        for lineno, kind, detail in scan_content_defects(p):
            rel = p.relative_to(memory_dir)
            (joined if kind == "joined-line" else longish).append((rel, lineno, detail))

    # Summary
    reds    = [v for v in verdicts if v[1] == RED_RANK]
    yellows = [v for v in verdicts if v[1] == YELLOW_RANK]
    mem_gloss = scan_index_gloss(_mem) if _mem.exists() else []
    rs_gloss = scan_recent_state_bullets(_mem) if _mem.exists() else []
    rs_dupes = scan_recent_state_duplicates(_mem) if _mem.exists() else []
    idx_incomplete = scan_index_completeness(memory_dir)
    ptr_rot = scan_pointer_resolution(memory_dir)
    ptr_empty = scan_pointer_content(memory_dir)
    ungated_over, ungated_totals = scan_ungated_trees(memory_dir)
    if reds:
        print(f"{RED}{BOLD}⚠  {len(reds)} file(s) over limit:{RESET} "
              + ", ".join(f"{n} ({why})" for n, _, why in reds))
    if joined:
        red = f"{RED}{BOLD}RED{RESET}"   # exact token the pre-commit hook greps to block
        print(f"{RED}{BOLD}⚠  {len(joined)} joined-line defect(s){RESET} [{red}] — "
              "a merged bullet hides a fact; fix the missing newline before commit:")
        for rel, lineno, detail in joined:
            print(f"   {rel}:{lineno}  {detail}")
    if yellows:
        print(f"{YELLOW}⚡  {len(yellows)} file(s) approaching limit:{RESET} "
              + ", ".join(f"{n} ({why})" for n, _, why in yellows))
    if longish:
        print(f"{YELLOW}⚡  {len(longish)} runaway line(s) >{LONG_LINE_CHARS} chars "
              f"(accretion — compress to a pointer):{RESET}")
        for rel, lineno, detail in longish:
            print(f"   {rel}:{lineno}  {detail}")
    if mem_gloss:
        print(f"{YELLOW}⚡  {len(mem_gloss)} MEMORY.md index line(s) >{INDEX_GLOSS_WARN}B "
              f"non-link gloss (Gap-32 accretion — move the detail to the linked file, "
              f"keep the index a terse hook):{RESET}")
        for lineno, gloss, total, preview in mem_gloss:
            print(f"   MEMORY.md:{lineno}  {gloss}B gloss / {total}B line  {preview}…")
    if rs_gloss:
        print(f"{YELLOW}⚡  {len(rs_gloss)} Recent State bullet(s) >{RECENT_STATE_BULLET_WARN}B "
              f"non-link gloss (a fact outgrew the changelog — home it in a project/domain "
              f"file + leave a pointer, or `gaius recent-roll` evicts it once done):{RESET}")
        for lineno, gloss, total, preview in rs_gloss:
            print(f"   MEMORY.md:{lineno}  {gloss}B gloss / {total}B line  {preview}…")
    if rs_dupes:
        print(f"{YELLOW}⚡  {len(rs_dupes)} changelog bullet pair(s) cite the SAME event "
              f"(Gap-43 duplication — two sessions wrote one event twice; this is the "
              f"dominant byte-growth vector. MERGE them, never delete: each usually "
              f"carries a detail the other lacks):{RESET}")
        for la, lb, kind, ss, sw, pa, pb in rs_dupes:
            shared = ", ".join(ss + sw[:4])
            print(f"   MEMORY.md:{la} ~ :{lb}  [{kind}] shared: {shared}")
            print(f"      :{la}  {pa}…")
            print(f"      :{lb}  {pb}…")
    if ptr_rot:
        print(f"{YELLOW}⚡  {len(ptr_rot)} MEMORY.md pointer(s) do not resolve "
              f"(Gap-42 pointer rot — a pointer is a CLAIM about another file and "
              f"rots independently of its bullet; repair the path or re-home the "
              f"fact, do not just delete the arrow):{RESET}")
        for relfile, lineno, kind, target, detail in ptr_rot:
            print(f"   {relfile}:{lineno}  {kind}: {target} — {detail}")
    if ptr_empty:
        print(f"{YELLOW}⚡  {len(ptr_empty)} MEMORY.md pointer(s) RESOLVE but the target "
              f"does not contain the fact (Gap-42 class (a) — the bullet was compressed "
              f"behind an arrow before it was homed; promote the content, then compress):{RESET}")
        for relfile, lineno, idents, rels, preview in ptr_empty:
            shown = ", ".join(f"`{d}`" for d in idents[:4])
            more = f" +{len(idents) - 4}" if len(idents) > 4 else ""
            print(f"   {relfile}:{lineno}  none of {shown}{more} in {rels}")
            print(f"                 {preview}…")
    if idx_incomplete:
        by_tree: dict[str, dict[str, list]] = {}
        for tree, key, knd in idx_incomplete:
            by_tree.setdefault(tree, {"missing": [], "ghost": []})[knd].append(key)
        n_miss = sum(len(v["missing"]) for v in by_tree.values())
        n_ghost = sum(len(v["ghost"]) for v in by_tree.values())
        print(f"{YELLOW}⚡  INDEX drift in {len(by_tree)} tree(s): {n_miss} file(s) unlisted, "
              f"{n_ghost} listed-but-gone (an index that is not a bijection with its tree "
              f"hides files from every session that reads only the index — reconcile):{RESET}")
        for tree in sorted(by_tree):
            miss, ghost = by_tree[tree]["missing"], by_tree[tree]["ghost"]
            if miss:
                print(f"   {tree}/ missing: {', '.join(miss[:15])}"
                      f"{f' … +{len(miss) - 15}' if len(miss) > 15 else ''}")
            if ghost:
                print(f"   {tree}/ ghost:   {', '.join(ghost[:15])}"
                      f"{f' … +{len(ghost) - 15}' if len(ghost) > 15 else ''}")
    if ungated_over:
        tsum = ", ".join(f"{t}/ {n} files {b / 1024:.0f}KB" for t, n, b in ungated_totals)
        print(f"{YELLOW}⚡  {len(ungated_over)} ungated file(s) over the "
              f"{UNGATED_ADVISORY_BYTES // 1024}KB advisory ceiling (Gap-58 — these trees are "
              f"byte-gated NOWHERE; reported, never ranked, so a split is a judgement "
              f"call and not a commit blocker). Weight: {tsum}:{RESET}")
        for rel, sz in ungated_over[:5]:
            print(f"   {rel}  {sz / 1024:.0f}KB")
        if len(ungated_over) > 5:
            print(f"   … +{len(ungated_over) - 5} more over {UNGATED_ADVISORY_BYTES // 1024}KB")
    if byte_yellow:
        print(f"{YELLOW}⚡  MEMORY.md over the 16KB injection-budget warn — compress.{RESET}")
    if byte_red:
        red = f"{RED}{BOLD}RED{RESET}"
        print(f"{RED}{BOLD}⚠  MEMORY.md over the 20KB error{RESET} [{red}] — compress before commit.")
    if (byte_yellow or byte_red) and _mem.exists():
        print(f"{YELLOW}   heaviest lines (target these first):{RESET}")
        for lineno, length, preview in heaviest_lines(_mem):
            print(f"     MEMORY.md:{lineno}  {length}B  {preview}…")
    if (not reds and not yellows and not joined and not longish
            and not byte_red and not byte_yellow and not mem_gloss
            and not rs_gloss and not rs_dupes and not idx_incomplete and not ptr_rot
            and not ptr_empty and not ungated_over):
        print(f"{GREEN}✓  All files within threshold.{RESET}")
    print()


def cmd_audit(memory_dir: Path, args: list):
    """Scan common.md for entries that belong in domain files instead."""
    common = memory_dir / "common.md"
    if not common.exists():
        print(f"ERROR: {common} not found", file=sys.stderr)
        sys.exit(1)

    lines = common.read_text().splitlines()
    findings = []  # list of (line_num, line_text, suggested_domain)

    for i, line in enumerate(lines, 1):
        stripped = line.strip()
        # Only check bullet-point lines (agents write bullet facts)
        if not stripped.startswith("-") and not stripped.startswith("*"):
            continue
        lower = stripped.lower()
        matches = []
        for domain, keywords in DOMAIN_KEYWORDS.items():
            for kw in keywords:
                if kw.lower() in lower:
                    matches.append(domain)
                    break
        # Only flag if matched and the content seems too specific for common.md
        # (common.md is for cross-cutting hard rules; domain-specific gotchas belong elsewhere)
        if matches:
            # Skip if line is a universal hard rule (never, always, all agents)
            is_universal = any(w in lower for w in ["never", "always", "all agents", "hard rule"])
            if not is_universal:
                findings.append((i, stripped[:100], matches[0]))

    if not findings:
        print(f"{GREEN}✓  No domain-specific entries found in common.md.{RESET}")
        return

    print(f"\n{YELLOW}⚡  {len(findings)} entries in common.md may belong in domain files:{RESET}\n")
    by_domain: dict[str, list] = {}
    for lineno, text, domain in findings:
        by_domain.setdefault(domain, []).append((lineno, text))

    for domain in sorted(by_domain):
        print(f"  → {BOLD}domain/{domain}.md{RESET}")
        for lineno, text in by_domain[domain]:
            print(f"     line {lineno:3d}: {text[:90]}")
        print()

    print("These are suggestions only. Review before moving.\n")


def cmd_split(memory_dir: Path, args: list):
    """Propose a split plan for an oversized file. Never auto-executes."""
    if not args:
        print("Usage: mnemosyne split <file>", file=sys.stderr)
        sys.exit(1)

    target = Path(args[0])
    if not target.is_absolute():
        target = memory_dir / args[0]
    if not target.exists():
        print(f"ERROR: {target} not found", file=sys.stderr)
        sys.exit(1)

    lines = target.read_text().splitlines()
    total = len(lines)
    print(f"\n{BOLD}Split proposal for {target.name}{RESET} ({total} lines)\n")

    # Parse sections by H2 (##) headers
    sections = []  # list of (header_text, start_line, line_count)
    current_header = "(preamble)"
    current_start = 1
    current_lines = 0

    for i, line in enumerate(lines, 1):
        if line.startswith("## "):
            if current_lines > 0:
                sections.append((current_header, current_start, current_lines))
            current_header = line[3:].strip()
            current_start = i
            current_lines = 1
        else:
            current_lines += 1

    if current_lines > 0:
        sections.append((current_header, current_start, current_lines))

    # Print section breakdown
    col_h = max(len(s[0]) for s in sections) + 2
    print(f"  {'Section':<{col_h}} {'Lines':>6}  {'Start':>6}")
    print("  " + "─" * (col_h + 16))
    for header, start, count in sections:
        flag = f"  {YELLOW}←{RESET}" if count > 30 else ""
        print(f"  {header:<{col_h}} {count:>6}  {start:>6}{flag}")

    print()

    # Identify move candidates (sections > 30 lines that look like gotcha/troubleshooting content)
    TROUBLESHOOTING_MARKERS = [
        "gotcha", "issue", "fix", "debug", "troubleshoot", "problem", "error",
        "broken", "caveat", "warning", "boot", "race", "drift", "leak"
    ]
    TOPIC_FILE_MARKERS = {
        "storage":      ["storage", "drbd", "pvc", "s3", "volume"],
        "networking":   ["network", "flannel", "cilium", "dns", "tunnel", "ingress"],
        "observability":["observ", "metric", "alert", "grafana", "loki"],
        "services":     ["service", "oauth", "helm", "cert"],
    }

    candidates = []
    for header, start, count in sections:
        if count < 15:
            continue
        lower = header.lower()
        # Check if section looks like troubleshooting content
        if any(m in lower for m in TROUBLESHOOTING_MARKERS):
            candidates.append((header, start, count, "troubleshooting.md"))
            continue
        # Check topic file matches
        for topic, markers in TOPIC_FILE_MARKERS.items():
            if any(m in lower for m in markers):
                candidates.append((header, start, count, f"{topic}.md"))
                break

    if candidates:
        print(f"{YELLOW}Suggested moves (lines {total} → target <{int(total*0.6)}):{RESET}\n")
        saved = 0
        for header, start, count, dest in candidates:
            print(f"  Move '{header}' ({count} lines, starts at {start}) → {dest}")
            saved += count
        remaining = total - saved
        print(f"\n  After moves: ~{remaining} lines remaining in {target.name}")
        if remaining <= 180:
            print(f"  {GREEN}✓ Would bring file within threshold.{RESET}")
        else:
            print(f"  {YELLOW}⚡ Still over warn threshold — consider further consolidation.{RESET}")
    else:
        print(f"{YELLOW}No obvious split candidates found. Review sections manually.{RESET}")

    print(f"\n{BOLD}This is a proposal only.{RESET} Apply changes manually.\n")


def cmd_prune(memory_dir: Path, args: list):
    """Identify redundant or stale entries in a memory file. Never auto-deletes."""
    if not args:
        print("Usage: mnemosyne prune <file>", file=sys.stderr)
        sys.exit(1)

    target = Path(args[0])
    if not target.is_absolute():
        target = memory_dir / args[0]
    if not target.exists():
        print(f"ERROR: {target} not found", file=sys.stderr)
        sys.exit(1)

    lines = target.read_text().splitlines()
    total = len(lines)
    findings = []

    # Patterns that signal stale or speculative content
    STALE_PATTERNS = [
        (r"\bpending\b",               "pending implementation"),
        (r"\bnot yet (built|implemented|functional|wired)\b", "unbuilt feature"),
        (r"\bdeferred\b",              "deferred item"),
        (r"\bfuture\b",                "future/speculative"),
        (r"\bdesign intent\b",         "design intent (not reality)"),
        (r"\bTODO\b",                  "TODO marker"),
        (r"\bWIP\b",                   "work in progress"),
        (r"\btemporary\b",             "marked temporary"),
        (r"#\d{1,3}\b.*\bpending\b",   "open issue (pending)"),
        (r"\bfixed\b.*\b20\d\d-\d\d-\d\d\b", "dated fix (verify still relevant)"),
    ]

    # Duplicate detection — track H2 section headers
    seen_headers = {}
    current_section = None
    seen_bullet_keys = {}

    for i, line in enumerate(lines, 1):
        stripped = line.strip()

        # Track section headers for duplicate detection
        if line.startswith("## "):
            header = line[3:].strip()
            if header in seen_headers:
                findings.append((i, line.strip(), f"duplicate section header (first at line {seen_headers[header]})"))
            seen_headers[header] = i
            current_section = header
            continue

        # Check stale patterns
        lower = stripped.lower()
        for pattern, label in STALE_PATTERNS:
            if re.search(pattern, lower):
                findings.append((i, stripped[:100], label))
                break

        # Track bullet keys for rough duplicate detection (first 6 words as key)
        if stripped.startswith("-") or stripped.startswith("*"):
            words = lower.split()[:6]
            key = " ".join(words)
            if key in seen_bullet_keys and key not in {"- **", "- use", "- never", "- all"}:
                findings.append((i, stripped[:100],
                                  f"possible duplicate of line {seen_bullet_keys[key]}"))
            else:
                seen_bullet_keys[key] = i

    if not findings:
        print(f"\n{GREEN}✓  No obvious stale or redundant entries found in {target.name}.{RESET}\n")
        return

    print(f"\n{YELLOW}⚡  {len(findings)} candidate(s) for pruning in {target.name}:{RESET}\n")
    for lineno, text, reason in findings:
        print(f"  line {lineno:4d}: [{reason}]")
        print(f"           {text[:95]}")
        print()

    print(f"{BOLD}This is a proposal only.{RESET} Review each entry before removing.\n")


# ── Dispatch ─────────────────────────────────────────────────────────────────

COMMANDS = {
    "health": cmd_health,
    "audit":  cmd_audit,
    "split":  cmd_split,
    "prune":  cmd_prune,
}


def main():
    parser = argparse.ArgumentParser(
        description="Memory file health and maintenance",
        usage="mnemosyne [--memory-dir DIR] <command> [args]",
    )
    parser.add_argument("--memory-dir", type=str, default=None,
                        help="Override memory root directory (env: MNEMOSYNE_MEMORY_DIR)")
    parser.add_argument("command", choices=list(COMMANDS.keys()),
                        help="Command to run")
    parser.add_argument("args", nargs="*", help="Command arguments")

    parsed = parser.parse_args()

    # Resolve memory dir: flag > env > default
    memory_dir = DEFAULT_MEMORY_DIR
    if parsed.memory_dir:
        memory_dir = Path(parsed.memory_dir)
    elif os.environ.get("MNEMOSYNE_MEMORY_DIR"):
        memory_dir = Path(os.environ["MNEMOSYNE_MEMORY_DIR"])

    if not memory_dir.is_dir():
        print(f"ERROR: memory directory not found: {memory_dir}", file=sys.stderr)
        sys.exit(1)

    COMMANDS[parsed.command](memory_dir, parsed.args)


if __name__ == "__main__":
    main()
